{
  "name": "nest-and-nova",
  "version": "1.0.0",
  "description": "NEST & NOVA - Premium Electronics & Furniture E-Commerce Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
