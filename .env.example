# ==============================================================================
# NEST & NOVA - Environment Configuration Template (.env.example)
# Duplicate this file to '.env' and fill in the values for your environment.
# Note: In-memory fallback database activates automatically if MySQL is offline.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=nest_and_nova

# Authentication & Session Security
# Generate cryptographically strong random strings for production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_here

# E-Commerce & Checkout Settings
FREE_SHIPPING_THRESHOLD=4999
PAYMENT_MODE=mock

# Email Notification Service (SMTP)
# Optional: Nodemailer defaults to mock mode if left blank or unconfigured
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="NEST & NOVA" <orders@nestandnova.com>
